{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestrel",
  "version": "0.1.0",
  "identifier": "dev.kestrel.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kestrel",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0e1116"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Game",
    "shortDescription": "Fast Minecraft: Java Edition launcher",
    "longDescription": "Kestrel is a fast, lightweight Minecraft: Java Edition launcher for Linux with mod, resource pack and shader management.",
    "license": "GPL-3.0-or-later",
    "publisher": "Kestrel contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
